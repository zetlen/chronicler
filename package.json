{
  "name": "chronicler",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:php": "node scripts/test-php.mjs",
    "build:admin": "node scripts/build-admin-bundle.mjs",
    "build:plugin": "node scripts/build-plugin-zip.mjs",
    "check:version": "node scripts/check-version.mjs",
    "sync:github": "node scripts/sync-github.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "bump": "node scripts/bump-version.mjs",
    "sandbox": "node scripts/sandbox.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.10",
    "codemirror": "^6.0.2",
    "codemirror-json-schema": "^0.8.1",
    "dompurify": "^3.4.8",
    "fflate": "^0.8.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "slack-markdown": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/cli": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@wordpress/rich-text": "^7.50.0",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@wordpress/rich-text": {
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "@types/react": "19.2.17"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
