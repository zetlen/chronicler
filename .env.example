# Copy to .env and fill in. All values are local-only; nothing here is committed.
# Consumers load .env themselves (they are not exported automatically).

# --- deploy-plugin.sh: the private SSH deploy convenience -----------------------
# The public install path is uploading the built zip in wp-admin; these are only
# for `./deploy-plugin.sh`, which requires both to be set.
WP_REMOTE=              # ssh host of the WordPress install, e.g. myblog.host.com
WP_REMOTE_DIR=          # WordPress root on that host, e.g. $HOME/myblogs.com/wordpress

# --- .claude/skills/verify: runtime verification against a real Slack workspace -
# The dev Slack workspace the bot lives in, and a known-good session for
# transform/renderer checks. The token needs files:read for image fetches.
DEV_SLACK_USER_TOKEN=                    # Slack user token (xoxp-…)
DEV_SLACK_CHANNEL=                       # channel the bot can read, e.g. dargon-kween
DEV_SLACK_KNOWN_GOOD_FIXTURE_DATE_UTC=   # date with an RPG session, UTC, e.g. 2026-06-25

# --- scripts/sandbox.mjs: the disposable Slack sandbox workspace ----------------
# See docs/runbooks/slack-sandbox.md for how to obtain each of these.
SANDBOX_SLACK_CONFIG_TOKEN=
SANDBOX_SLACK_CONFIG_REFRESH_TOKEN=
SANDBOX_SLACK_APP_ID=
SANDBOX_SLACK_SIGNING_SECRET=
SANDBOX_SLACK_BOT_TOKEN=
